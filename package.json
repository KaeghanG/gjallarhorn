{
  "name": "gjallarhorn",
  "productName": "Gjallarhorn",
  "version": "0.1.0",
  "description": "Norse-themed game hub: price comparison, library, optimizer, OptiScaler, bundles, emulators.",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "package": "vite build && electron-builder --win nsis",
    "package:dir": "vite build && electron-builder --win dir"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "framer-motion": "^14.14.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "author": "Gjallarhorn contributors",
  "license": "MIT",
  "build": {
    "appId": "io.github.gjallarhorn",
    "productName": "Gjallarhorn",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gjallarhorn",
      "artifactName": "Gjallarhorn-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  }
}
